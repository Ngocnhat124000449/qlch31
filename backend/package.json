{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "types": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:create": "dotenv -e .env -- node-pg-migrate create -m js --migrations-dir migrations",
    "migrate:up": "dotenv -e .env -- node-pg-migrate up --migrations-dir migrations",
    "migrate:down": "dotenv -e .env -- node-pg-migrate down --migrations-dir migrations",
    "migrate:status": "dotenv -e .env -- node --input-type=module -e \"import pg from 'pg'; const { Pool } = pg; const pool = new Pool({ connectionString: process.env.DATABASE_URL, ssl: { rejectUnauthorized: false } }); const { rows } = await pool.query('SELECT name, run_on FROM public.pgmigrations ORDER BY run_on ASC'); console.table(rows); await pool.end();\"\n",
    "tool:banner:upload": "node src/tools/banner/upload.js",
    "tool:admin:list": "node src/tools/admin/user-management.js list",
    "tool:admin:get": "node src/tools/admin/user-management.js get",
    "tool:admin:password": "node src/tools/admin/user-management.js password",
    "tool:admin:enable": "node src/tools/admin/user-management.js enable",
    "tool:admin:disable": "node src/tools/admin/user-management.js disable"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.16.3",
    "streamifier": "^0.1.1",
    "tedious": "^19.1.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.11"
  }
}
